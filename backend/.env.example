# 1. 关系型数据库与缓存配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=medical_spd_system

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# 2. 向量数据库与本地 Ollama 配置
CHROMA_PERSIST_DIR=./chroma_data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_CHAT_MODEL=qwen3.5:2b

# 3. 本地 Neo4j 知识图谱配置 (可选)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 4. 云端大模型配置 (可选小米 MiMo / DeepSeek / 通义千问)
LLM_PROVIDER=ollama
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MIMO_MODEL=mimo-v2.6-flash

# 5. LangSmith 可观测追踪配置 (可选)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=Personal

# 6. Coze 智能体协同配置 (可选)
COZE_ENABLED=false
COZE_API_TOKEN=your_coze_pat_token
COZE_BOT_ID=your_coze_bot_id
COZE_BASE_URL=https://api.coze.cn
COZE_TIMEOUT=60

# 7. 飞书开放平台配置 (可选)
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_WEBHOOK_URL=

# 8. 安全与认证配置
JWT_SECRET_KEY=spd_super_secret_jwt_key_2026_hospital
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 1. 关系型数据库与缓存配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=medical_spd_system

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 2. 向量数据库与本地 Ollama 配置
CHROMA_PERSIST_DIR=./chroma_data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b

# 3. 云端小米 MiMo 大模型配置
LLM_PROVIDER=ollama
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key
XIAOMI_MIMO_BASE_URL=https://api.xiaomi.com/v1
XIAOMI_MIMO_MODEL=mimo-pro

# 4. 可选 Coze 智能体协同配置
COZE_ENABLED=false
COZE_API_TOKEN=your_coze_pat_token
COZE_BOT_ID=your_coze_bot_id

# 5. 安全与认证配置
JWT_SECRET_KEY=spd_super_secret_jwt_key_2026_hospital
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

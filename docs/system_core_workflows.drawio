        <mxCell id="t2_e_judge_no" value="否 (查无数据)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ef4444;" edge="1" parent="1" source="t2_judge_found" target="t2_not_found">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 未找到回路回到前端输入 -->
        <mxCell id="t2_e_retry_input" value="重新核对输入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ef4444;dashed=1;" edge="1" parent="1" source="t2_not_found" target="t2_f_comp">

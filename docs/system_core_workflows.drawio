  <diagram id="diag_udi" name="模块二：高值耗材UDI溯源与召回追访流程">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1120" math="0" shadow="0">
      <root>

        <mxCell id="0" />

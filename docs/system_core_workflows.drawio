        <mxCell id="t2_e_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10b981;" edge="1" parent="1" source="t2_start" target="t2_f_comp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 后端接口与函数 -->
        <mxCell id="t2_b_api" value="high_value_router.py&#xa;路由: GET /api/v1/ext/recall/trace-patients&#xa;函数: trace_recall_patients(udi: str, batch_no: str, db: Session)&#xa;入参: udi 或 batch_no" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t2_e_f_to_b" value="HTTP GET" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10b981;" edge="1" parent="1" source="t2_f_comp" target="t2_b_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 关联 ORM 穿透查询 -->
        <mxCell id="t2_orm_query" value="关联 6W 流转日志与患者全生命周期数据&#xa;1. 查 Log6WTraceORM: 穿透操作人、时间、科室、出入库动作&#xa;2. 查 HighValueItemORM / MaterialStockORM: 锁定院内当前库房与在库状态&#xa;3. 查 PatientConsumeORM: 提取已植入该批次的关联患者记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="t2_e_api_to_orm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3b82f6;" edge="1" parent="1" source="t2_b_api" target="t2_orm_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 菱形分支：是否查到匹配记录 -->
        <mxCell id="t2_judge_found" value="是否查到关联的&#xa;流转记录与患者？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="430" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t2_e_orm_to_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#7c3aed;" edge="1" parent="1" source="t2_orm_query" target="t2_judge_found">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 未找到分支：友好提示并返回闭环 -->
        <mxCell id="t2_not_found" value="返回空数组并提示：&#xa;ElMessage.warning('未检索到该 UDI 或批号的院内流转记录')&#xa;引导用户核对批号后重新输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=12;" vertex="1" parent="1">
